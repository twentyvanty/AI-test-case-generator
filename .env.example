# Copy to .env (same folder as docker-compose.yml) and fill in. Never commit .env.
# Used by `docker compose up` for Keycloak.

# Google login ("Continue with Google"): the client secret of the team's Google
# OAuth client. Ask a teammate for it (shared privately, not in git). Without it,
# Keycloak still starts, but the Google button fails; email + password login works.
GOOGLE_CLIENT_SECRET=
