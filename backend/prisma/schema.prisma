// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Display codes (REQ-0001, SC-01, TC-0001) are not stored.
// Each table stores a `number` and the app formats it.

enum RequirementStatus {
  DRAFT // text/techniques entered, nothing generated yet
  SCENARIOS_READY // scenarios drafted (step 2 unlocked)
  CASES_READY // test cases generated (step 3 unlocked)
  REPORTED // report built (step 4 unlocked)
}

enum GenerationKind {
  TECHNIQUE_SUGGESTION
  SCENARIOS
  TEST_CASES
}

enum GenerationStatus {
  PASSED // output passed validation
  NEEDS_REVIEW // failed validation 3 times — tester must check it manually
  FAILED // provider/quota error, no usable output
}

// Result of running a test case (set by the tester in Step 3)
enum TestCaseStatus {
  OPEN // not run yet
  PASS
  FAIL
}

enum ItemSource {
  AI
  MANUAL
}

model User {
  id         Int     @id @default(autoincrement())
  keycloakId String  @unique
  email      String?
  name       String?

  projects   Project[]
  preference UserPreference?
  imageReads ImageRead[]
}

// One AI read of a requirement image (Step 1, D-027), successful or not. The image
// itself is never stored; this keeps the result and the measurements (D-033).
// Not linked to a requirement yet: images are read before the requirement is saved.
model ImageRead {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  fileName     String           @db.VarChar(255)
  mimeType     String           @db.VarChar(50)
  size         Int // bytes
  status       GenerationStatus // PASSED; FAILED = busy, quota… (no text)
  attempts     Int
  model        String           @db.VarChar(100) // the model(s) that answered, e.g. a fallback
  seconds      Float // wall time of the whole read, retries included
  text         String?          @db.Text // what was read (null if it failed)
  validation   Json? // format check per attempt, with each attempt's time
  usage        Json? // tokens, for the future credit system
  errorMessage String?          @db.Text

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Project {
  id          Int     @id @default(autoincrement())
  name        String
  description String? @db.Text

  userId Int
  user   User @relation(fields: [userId], references: [id])

  requirements Requirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Requirement {
  id Int @id @default(autoincrement())

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  number         Int // shown as REQ-0001, unique per project
  title          String            @db.VarChar(255)
  text           String            @db.Text
  sourceFileName String?           @db.VarChar(255)
  techniques     Json // technique keys, e.g. ["boundaryValue"] — strings so new techniques need no migration
  status         RequirementStatus @default(DRAFT)

  scenarios Scenario[]
  testCases TestCase[]
  runs      GenerationRun[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Set = in "Recently deleted"; permanently removed 7 days later (numbers are never reused)
  deletedAt DateTime?

  @@unique([projectId, number])
  @@index([deletedAt])
}

// One row per AI generation (history + audit). The latest 10 per kind
// are shown to the tester and can be restored from `output`.
model GenerationRun {
  id Int @id @default(autoincrement())

  requirementId Int
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  kind           GenerationKind
  status         GenerationStatus
  attempts       Int // 1–3
  generatorModel String           @db.VarChar(100)
  validatorModel String           @db.VarChar(100)
  input          Json // what was sent: text, techniques, selected scenarios
  output         Json? // result snapshot, used for restore
  validation     Json? // check results + issues per attempt
  usage          Json? // token counts, for the future credit system
  errorMessage   String?          @db.Text
  // "Mark as reviewed" on a NEEDS_REVIEW run (hides its review note)
  reviewedAt     DateTime?

  scenarios Scenario[]
  testCases TestCase[]

  createdAt DateTime @default(now())

  @@index([requirementId, kind, createdAt])
}

model Scenario {
  id Int @id @default(autoincrement())

  requirementId Int
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  // The generation that produced it (null for manual ones or if the run is deleted)
  runId Int?
  run   GenerationRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  // Shown as SC-01. Unique among the requirement's active (not deleted) scenarios —
  // kept by the code, because a deleted SC-02 can wait in the bin while a new SC-02 exists
  number         Int
  title          String     @db.VarChar(255)
  description    String     @db.Text
  technique      String?    @db.VarChar(50)
  estimatedCases Int        @default(0)
  source         ItemSource
  position       Int

  testCases TestCase[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Set = in "Recently deleted"; permanently removed 7 days later
  deletedAt DateTime?

  @@index([requirementId, number])
  @@index([deletedAt])
}

model TestCase {
  id Int @id @default(autoincrement())

  scenarioId Int
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  // Also stored here so TC numbers are unique per requirement and reports stay simple
  requirementId Int
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  // The generation that produced it (null for older rows or if the run is deleted)
  runId Int?
  run   GenerationRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  number              Int // shown as TC-0001, unique among the requirement's active test cases (kept by the code)
  title               String         @db.VarChar(255)
  description         String         @db.Text
  precondition        String         @db.Text
  steps               Json // string[]
  expectedResult      String         @db.Text
  technique           String?        @db.VarChar(50)
  source              ItemSource
  position            Int
  status              TestCaseStatus @default(OPEN)
  // true = deleted together with its scenario (D-029), so restoring the scenario
  // brings back exactly these cases and not ones deleted on their own
  deletedWithScenario Boolean        @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Set = in "Recently deleted"; permanently removed 7 days later
  deletedAt DateTime?

  @@index([requirementId, number])
  @@index([deletedAt])
}

model UserPreference {
  id Int @id @default(autoincrement())

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  exportColumns Json? // saved Excel/CSV column choice

  updatedAt DateTime @updatedAt
}
