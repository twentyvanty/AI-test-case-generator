# Copy this file to .env and fill in your own values
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE_NAME"

PORT=5001

# Optional — defaults match the local docker-compose Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=ai-test-case-generator
# Client used by Swagger's "Authorize" button
KEYCLOAK_CLIENT_ID=ai-test-case-frontend

# --- AI (see docs/ai-providers.md) ---
# Main provider: OpenRouter (one key, many models). Key: https://openrouter.ai/keys
# Free ":free" models: ~20 requests/min and 50/day (1,000/day once $10 of credits is bought).
# Free models may be hosted by providers that log prompts — don't paste confidential requirements.
# Paid later: add credits and change the model names below; no code change.
OPENROUTER_API_KEY=
# Optional overrides (defaults shown; chosen by measurement on 2026-11-06/07)
# OPENROUTER_GENERATOR_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_VALIDATOR_MODEL=nvidia/nemotron-3.5-super-vl:free
# Used when the main model is busy or too slow; "none" disables
# OPENROUTER_GENERATOR_FALLBACK_MODEL=recursive/flint-v1.0:free
# OPENROUTER_VALIDATOR_FALLBACK_MODEL=cohere/north-mini-code:free
# Backup image reader, used when Gemini is busy or not set up (Step 1); must accept image input
# OPENROUTER_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# OPENROUTER_VISION_FALLBACK_MODEL=google/gemma-4-31b-it:free
# Shown on openrouter.ai as the app making the requests (optional)
# OPENROUTER_APP_URL=http://localhost:5173
# OPENROUTER_APP_NAME=AI Test Case Generator

# Gemini (second provider; recommended for reading requirement images). Free key: https://aistudio.google.com → "Get API key".
# Without any key, the mock provider is used.
# Free tier: Google may use prompts to improve its products — don't paste confidential requirements.
GEMINI_API_KEY=
# Optional overrides (defaults shown)
# GEMINI_GENERATOR_MODEL=gemini-3.5-flash
# GEMINI_VALIDATOR_MODEL=gemini-3.5-flash-lite
# Used when the main model is busy or too slow; "none" disables
# GEMINI_GENERATOR_FALLBACK_MODEL=gemini-3.7-flash
# GEMINI_VALIDATOR_FALLBACK_MODEL=gemini-3.1-flash-lite
# Reads requirement images. With a Gemini key, images go to Gemini first (best reader
# in our tests), then to OpenRouter's vision model if Gemini is busy.
# GEMINI_VISION_MODEL=gemini-3.5-flash
# GEMINI_VISION_FALLBACK_MODEL=gemini-3.7-flash
# Time limit for one AI request, in seconds
# AI_REQUEST_TIMEOUT_SECONDS=120
# Provider per role: openrouter | gemini | mock
# (default: openrouter if OPENROUTER_API_KEY is set, else gemini if GEMINI_API_KEY is set, else mock;
#  images: Gemini first, OpenRouter as backup. AI_VISION_PROVIDER forces one provider)
# AI_VISION_PROVIDER=gemini
# AI_GENERATOR_PROVIDER=openrouter
# AI_VALIDATOR_PROVIDER=openrouter
# Print every AI request with timings (troubleshooting)
# AI_DEBUG=1
# Mock provider only: never | once | always | quota | busy
# MOCK_FAIL_MODE=never
