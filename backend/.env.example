# Copy this file to .env and fill in your own values
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE_NAME"

PORT=5001

# Optional — defaults match the local docker-compose Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=ai-test-case-generator
# Client used by Swagger's "Authorize" button
KEYCLOAK_CLIENT_ID=ai-test-case-frontend

# --- AI (see docs/ai-providers.md) ---
# Free key: https://aistudio.google.com → "Get API key". Without a key, the mock provider is used.
# Free tier: Google may use prompts to improve its products — don't paste confidential requirements.
GEMINI_API_KEY=
# Optional overrides (defaults shown)
# GEMINI_GENERATOR_MODEL=gemini-3.5-flash
# GEMINI_VALIDATOR_MODEL=gemini-3.5-flash-lite
# Used when the main model is busy or too slow; "none" disables
# GEMINI_GENERATOR_FALLBACK_MODEL=gemini-3.7-flash
# GEMINI_VALIDATOR_FALLBACK_MODEL=gemini-3.1-flash-lite
# Time limit for one AI request, in seconds
# AI_REQUEST_TIMEOUT_SECONDS=120
# Provider per role: gemini | mock (default: gemini if GEMINI_API_KEY is set, else mock)
# AI_GENERATOR_PROVIDER=gemini
# AI_VALIDATOR_PROVIDER=gemini
# Print every AI request with timings (troubleshooting)
# AI_DEBUG=1
# Mock provider only: never | once | always | quota | busy
# MOCK_FAIL_MODE=never
